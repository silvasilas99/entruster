    "item": [
        {
            "name": "Metadata",
            "item": [
                {
                    "name": "POST Register Metadata",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": {"raw": "{{base_url}}/api/metadata/", "host": ["{{base_url}}"], "path": ["api","metadata",""]},
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"patient_id\": 1,\n    \"asset_id\": 100,\n    \"name\": \"ECG Recording\",\n    \"value\": \"Base64EncodedECGData\",\n    \"version\": \"1.0\",\n    \"owner\": \"Hospital A\",\n    \"rights\": \"read-only\",\n    \"terms_of_access\": \"Authorized personnel only\",\n    \"zkp_proof\": \"zk_proof_string_here\"\n}"
                        }
                    }
                },
                {
                    "name": "GET List All Metadata",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/metadata/?patient_id=1&asset_id=100",
                            "host": ["{{base_url}}"],
                            "path": ["api","metadata",""],
                            "query": [
                                {"key": "patient_id", "value": "1"},
                                {"key": "asset_id", "value": "100"}
                            ]
                        }
                    }
                },
                {
                    "name": "GET Metadata by ID",
                    "request": {
                        "method": "GET",
                        "url": {"raw": "{{base_url}}/api/metadata/1", "host": ["{{base_url}}"], "path": ["api","metadata","1"]}
                    }
                },
                {
