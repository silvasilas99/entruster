                        "url": {"raw": "{{base_url}}/api/metadata/1", "host": ["{{base_url}}"], "path": ["api","metadata","1"]},
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"ECG Recording v2\",\n    \"value\": \"UpdatedBase64Data\",\n    \"version\": \"2.0\"\n}"
                        }
                    }
                },
                {
                    "name": "DELETE Metadata by ID",
