    "definitions": {
        "audit.AuditAction": {
            "type": "string",
            "enum": [
                "CREATE",
                "UPDATE",
                "DELETE",
                "LIST"
            ],
            "x-enum-varnames": [
                "ActionCreate",
                "ActionUpdate",
                "ActionDelete",
                "ActionList"
            ]
        },
        "audit.AuditModel": {
            "type": "object",
            "properties": {
                "action": {
                    "description": "Action is the operation that was performed (CREATE, UPDATE, DELETE, LIST).",
                    "allOf": [
                        {
                            "$ref": "#/definitions/audit.AuditAction"
                        }
                    ]
                },
                "actor": {
                    "description": "Actor is the identity that triggered the operation (e.g. a username or\ncertificate CN). Defaults to \"system\" when no actor is available.",
                    "type": "string"
                },
                "details": {
                    "description": "Details holds any additional context about the operation\n(e.g. the payload snapshot or a short description).",
                    "type": "string"
                },
                "entity": {
                    "description": "Entity identifies the domain object being audited (e.g. \"Metadata\").",
                    "type": "string"
                },
                "entity_id": {
                    "description": "EntityID is the primary-key value of the affected record.\nEmpty string means the operation targeted the entire collection (e.g. LIST).",
                    "type": "string"
                },
                "id": {
                    "description": "ID is an auto-incremented sequence number assigned at insertion time.",
                    "type": "integer"
                },
                "occurred_at": {
                    "description": "OccurredAt is the UTC timestamp of when the operation was recorded.",
                    "type": "string"
                }
            }
        },
        "metadata.MetadataModel": {
            "type": "object",
            "properties": {
                "asset_id": {
                    "type": "integer"
                },
                "created_at": {
                    "description": "Dates are stored as RFC3339 strings, matching the chaincode's on-chain representation.",
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "deleted_by": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "source": {
                    "type": "string"
                },
                "patient_id": {
                    "type": "integer"
                },
                "rights": {
                    "type": "string"
                },
                "terms_of_access": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "updated_by": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                }
            }
        },
        "thirdpartyappevent.ThirdPartyAppEventModel": {
            "type": "object",
            "properties": {
                "event_type": {
                    "type": "string"
                },
                "created_at": {
                    "description": "Dates are stored as RFC3339 strings, matching the chaincode's on-chain representation.",
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "deleted_by": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "description": {
                    "type": "string"
                },
                "app_id": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "updated_by": {
                    "type": "string"
                },
                "event_data": {
                    "type": "string"
                }
            }
        },
        "utils.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "An error occurred"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "utils.SuccessResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Operation completed successfully"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}